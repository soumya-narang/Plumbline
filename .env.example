# Copy to .env and fill in. Never commit .env.
FALKORDB_HOST=localhost
FALKORDB_PORT=6390
FALKORDB_PASSWORD=

# Language model used for tool selection and phrasing only; it never decides a verdict.
# Any server that speaks the chat-completions tool-calling protocol. Leave empty to use the built-in planner.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Seconds to wait for the model per request. Raise it for a large local model that is slow to load.
LLM_TIMEOUT=120
